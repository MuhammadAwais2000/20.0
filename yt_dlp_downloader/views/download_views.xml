<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_yt_dlp_download_list" model="ir.ui.view">
        <field name="name">yt.dlp.download.list</field>
        <field name="model">yt.dlp.download</field>
        <field name="arch" type="xml">
            <list string="URL Downloads">
                <field name="name"/>
                <field name="url"/>
                <field name="format_mode"/>
                <field name="extractor"/>
                <field name="file_name"/>
                <field name="state" widget="badge"
                         decoration-success="state == 'done'"
                         decoration-danger="state == 'error'"
                         decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_yt_dlp_download_form" model="ir.ui.view">
        <field name="name">yt.dlp.download.form</field>
        <field name="model">yt.dlp.download</field>
        <field name="arch" type="xml">
            <form string="URL Download">
                <header>
                    <button name="action_download" type="object" string="Download"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_download" type="object" string="Re-download"
                            invisible="state != 'done'"/>
                    <button name="action_open_attachment" type="object" string="Open Attachment"
                            invisible="not attachment_id"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Title (filled after download)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="url" placeholder="https://www.youtube.com/watch?v=..."/>
                            <field name="format_mode"/>
                        </group>
                        <group string="Result">
                            <field name="attachment_id"/>
                            <field name="file_name"/>
                            <field name="mimetype"/>
                            <field name="file_size"/>
                            <field name="extractor"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <group string="Media Player" col="1">
                        <div colspan="2" class="w-100 py-2">
                            <widget name="yt_dlp_media_player"/>
                        </div>
                    </group>
                    <group string="Error" invisible="state != 'error'">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" colspan="2" placeholder="Optional notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_yt_dlp_download_search" model="ir.ui.view">
        <field name="name">yt.dlp.download.search</field>
        <field name="model">yt.dlp.download</field>
        <field name="arch" type="xml">
            <search string="Search Downloads">
                <field name="name"/>
                <field name="url"/>
                <field name="extractor"/>
                <filter name="filter_done" string="Downloaded" domain="[('state', '=', 'done')]"/>
                <filter name="filter_error" string="Errors" domain="[('state', '=', 'error')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_format" string="Format" context="{'group_by': 'format_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_yt_dlp_download" model="ir.actions.act_window">
        <field name="name">URL Downloads</field>
        <field name="res_model">yt.dlp.download</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Download media from a URL
            </p>
            <p>
                Paste a video/audio URL, choose a format, then click Download.
                The file is stored as an Odoo attachment.
            </p>
        </field>
    </record>
</odoo>
