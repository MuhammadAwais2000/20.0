<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mail_voice_note" model="ir.module.category">
        <field name="name">Voice Notes</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_mail_voice_note" model="res.groups.privilege">
        <field name="name">Voice Notes</field>
        <field name="category_id" ref="module_category_mail_voice_note"/>
    </record>

    <record id="group_mail_voice_note" model="res.groups">
        <field name="name">Record Voice Notes</field>
        <field name="privilege_id" ref="res_groups_privilege_mail_voice_note"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Users in this group can record and send voice notes in chatter.</field>
    </record>
</odoo>
